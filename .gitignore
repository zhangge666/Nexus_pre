# 本文件定义 Nexus monorepo 在本地开发中不应提交的生成物与缓存。

/target/
node_modules/
/.pnpm-store/
/.turbo/
dist/
*.tsbuildinfo
*.log
# Tauri Android 工程是 M5 可复现构建所需的平台壳，纳入版本控制；其余生成目录仍忽略。
apps/*/src-tauri/gen/*
!apps/*/src-tauri/gen/android/
!apps/*/src-tauri/gen/android/**
# Tauri 移动插件的 Gradle 中间产物由构建脚本重建，不纳入源码。
crates/platform/platform-mobile/android/.tauri/
crates/platform/platform-mobile/android/build/
.DS_Store
