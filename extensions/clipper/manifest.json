{
  "manifest_version": 3,
  "name": "Nexus Clipper",
  "version": "0.1.0",
  "description": "把当前网页或选中文本一键剪藏到 Nexus。",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "action": {
    "default_title": "剪藏到 Nexus",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
