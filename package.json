{
  "name": "nexus",
  "private": true,
  "description": "Nexus 软件族 monorepo 的前端工作区与构建命令。",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "verify:orbit-m2": "powershell -ExecutionPolicy Bypass -File scripts/verify-orbit-m2.ps1",
    "verify:muse-m3": "powershell -ExecutionPolicy Bypass -File scripts/verify-muse-m3.ps1",
    "verify:orbit-m4": "powershell -ExecutionPolicy Bypass -File scripts/verify-orbit-m4.ps1",
    "verify:orbit-m5": "powershell -ExecutionPolicy Bypass -File scripts/verify-orbit-m5.ps1",
    "build:orbit-android-release": "powershell -ExecutionPolicy Bypass -File scripts/build-orbit-android-release.ps1",
    "smoke:orbit-android-device": "powershell -ExecutionPolicy Bypass -File scripts/verify-orbit-android-device.ps1",
    "verify:orbit-m6": "powershell -ExecutionPolicy Bypass -File scripts/verify-orbit-m6.ps1"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
